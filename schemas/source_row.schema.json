{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading.local/trading-data/source_row.schema.json",
  "title": "source_row",
  "type": "object",
  "required": ["source_id", "timestamp"],
  "properties": {
    "contract_type": {"const": "source_row"},
    "source_id": {"type": "string", "pattern": "^source_[0-9]{2}_[a-z0-9_]+$"},
    "model_layer": {"type": "string", "pattern": "^layer_[0-9]{2}_[a-z0-9_]+$"},
    "timestamp": {"type": "string"},
    "available_time": {"type": "string"},
    "payload": {"type": "object"}
  },
  "additionalProperties": true
}
