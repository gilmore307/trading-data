{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading.local/trading-data/task_key.schema.json",
  "title": "task_key",
  "type": "object",
  "required": ["contract_type", "task_id", "params", "output_root"],
  "properties": {
    "contract_type": {"const": "task_key"},
    "task_id": {"type": "string", "minLength": 1},
    "feed": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "params": {"type": "object"},
    "output_root": {"type": "string", "minLength": 1},
    "manager_controls": {
      "type": "object",
      "properties": {
        "allow_live_provider_calls": {"type": "boolean"},
        "autonomous_historical_provider_acquisition": {"type": "boolean"},
        "allowed_providers": {"oneOf": [{"const": "*"}, {"type": "array", "items": {"type": "string", "minLength": 1}}]},
        "allowed_endpoint_families": {"oneOf": [{"const": "*"}, {"type": "array", "items": {"type": "string", "minLength": 1}}]},
        "max_requests": {"type": "integer", "minimum": 0},
        "max_rows": {"type": "integer", "minimum": 0},
        "max_symbols": {"type": "integer", "minimum": 0},
        "max_time_window": {"type": "string", "pattern": "^([1-9][0-9]*(d|day|days|mo|month|months)|P(([1-9][0-9]*M)([1-9][0-9]*D)?|([1-9][0-9]*D)))$"},
        "timeout_seconds": {"type": "integer", "minimum": 0},
        "retry_policy_ref": {"type": "string", "minLength": 1},
        "rate_limit_policy_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {"required": ["feed"], "not": {"required": ["source"]}},
    {"required": ["source"], "not": {"required": ["feed"]}}
  ],
  "additionalProperties": false
}
